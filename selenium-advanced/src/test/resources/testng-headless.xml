<?xml version="1.0" encoding="UTF-8"?>
<suite name="TheInternetTestSuite-Headless" parallel="tests" thread-count="6">
    
    <test name="LoginTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.qa.selenium.LoginTest"/>
        </classes>
    </test>
    
    <test name="CheckboxTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.qa.selenium.CheckboxesTest"/>
        </classes>
    </test>
    
    <test name="DropdownTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.qa.selenium.DropdownTest"/>
        </classes>
    </test>
    
    <test name="AlertTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.qa.selenium.JavaScriptAlertsTest"/>
        </classes>
    </test>
    
    <test name="DynamicLoadingTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.qa.selenium.DynamicLoadingTest"/>
        </classes>
    </test>
    
    <test name="HoverTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
